generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator client_default {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  emailVerified         DateTime?
  image                 String?
  password              String? // Hashed, null for OAuth users
  role                  String         @default("STAFF")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  employee              Employee?
  roleRequests          RoleRequest[]
  approvedLeavesManager LeaveRequest[] @relation("ManagerApprovals")
  approvedLeavesHR      LeaveRequest[] @relation("HRApprovals")
  accounts              Account[]

  // --- P1 workflow relations ---
  passwordResetTokens PasswordResetToken[]
  securityFlag        UserSecurityFlag?

  // --- Multi-tenant relations ---
  memberships TenantMembership[]

  // --- Exit lifecycle relations (see the Exit* models at the end of this file)
  // Every one of these is a *named* relation because a single User appears in
  // four different roles on an exit case, and Prisma cannot infer four
  // relations to the same model on one side.
  exitCasesInitiated ExitCase[]      @relation("ExitCaseInitiatedBy")
  exitCasesDecided   ExitCase[]      @relation("ExitCaseDecidedBy")
  exitInterviews     ExitInterview[] @relation("ExitInterviewConductedBy")
  rehireAssessments  RehireRecord[]  @relation("RehireAssessedBy")

  // --- Performance relations ---
  performanceCyclesCreated       PerformanceCycle[]  @relation("PerformanceCycleCreatedBy")
  performanceReviewsApproved     PerformanceReview[] @relation("ReviewApprovedBy")
  performanceReviewsAcknowledged PerformanceReview[] @relation("ReviewAcknowledgedBy")

  // --- Training relations ---
  trainingCoursesCreated        TrainingCourse[]         @relation("TrainingCourseCreatedBy")
  trainingCoursesUpdated        TrainingCourse[]         @relation("TrainingCourseUpdatedBy")
  trainingSessionsCreated       TrainingSession[]        @relation("TrainingSessionCreatedBy")
  trainingSessionsInstructed    TrainingSession[]        @relation("TrainingSessionInstructor")
  trainingEnrollmentsCreated    TrainingEnrollment[]     @relation("TrainingEnrollmentEnrolledBy")
  trainingEnrollmentsApproved   TrainingEnrollment[]     @relation("TrainingEnrollmentApprovedBy")
  trainingAttendancesMarked     TrainingAttendance[]     @relation("TrainingAttendanceMarkedBy")
  trainingCertificatesIssued    TrainingCertificate[]    @relation("TrainingCertificateIssuedBy")
  trainingCertificatesRevoked   TrainingCertificate[]    @relation("TrainingCertificateRevokedBy")
  trainingCertificateTemplatesCreated TrainingCertificateTemplate[] @relation("TrainingCertificateTemplateCreatedBy")
  trainingAssessmentsCreated    TrainingAssessment[]     @relation("TrainingAssessmentCreatedBy")
  trainingAssessmentAttemptsGraded TrainingAssessmentAttempt[] @relation("TrainingAssessmentAttemptGradedBy")
  employeeTrainingSkills        EmployeeTrainingSkill[]  @relation("EmployeeTrainingSkillAssessedBy")
  supportTicketsCreated         SupportTicket[]          @relation("SupportTicketCreatedBy")
  supportTicketsAssigned        SupportTicket[]          @relation("SupportTicketAssignedTo")
  supportTicketsResolved        SupportTicket[]          @relation("SupportTicketResolvedBy")
  supportTicketMessages         SupportTicketMessage[]
  promotionsApproved            EmployeePromotion[]      @relation("EmployeePromotionApprovedBy")

  // --- AI relations ---
  aiUsageLogs AIUsageLog[] @relation("AIUsageLogUser")

  // --- Promotions relations ---
  promotionsCreated EmployeePromotion[] @relation("EmployeePromotionCreatedBy")
  temporaryRoleAssignments TemporaryRoleAssignment[] @relation("TemporaryRoleAssignmentUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RoleRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  requestedRole String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Temporary role assignment for time-bound elevated access
model TemporaryRoleAssignment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("TemporaryRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?  @relation("TemporaryRoleAssignmentTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  role        String   // ADMIN, HR, FINANCE, MANAGER, etc.
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive])
  @@index([tenantId, isActive])
  @@index([endDate, isActive])
}

// ─── P1 WORKFLOW SUPPORT ───────────────────────────────────────────────────────
// All models below are ADDITIVE. No existing model was altered and no row is
// removed. Each exists to make a workflow transactional, idempotent, auditable
// or recoverable rather than best-effort.

/// One-time credential issued instead of a shared default password (P1.1,
/// SEC-027). The plaintext token is NEVER stored — only its SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("FIRST_LOGIN") // FIRST_LOGIN, PASSWORD_RESET, OFFBOARDING
  expiresAt DateTime
  usedAt    DateTime?
  usedByIp  String?
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Forces a password change on next sign-in. P0 still gates the session, so a
/// forced-change user can read nothing sensitive until the reset completes.
model UserSecurityFlag {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mustChangePassword  Boolean   @default(false)
  mustChangeReason    String?
  accountDisabled     Boolean   @default(false)
  disabledReason      String?
  disabledAt          DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  updatedAt           DateTime  @updatedAt
}

/// Employee offboarding (P1.2). Historical HR/payroll/audit rows are retained;
/// offboarding disables access and changes status, it never deletes.
/// Onboarding checklist (P1.1 / FLOW-005).
///
/// Separate from OffboardingChecklistItem because the two lifecycles are
/// independent: an employee can be onboarded and never offboarded, and the
/// items differ. A requirement row is never treated as satisfied — `status`
/// stays PENDING until someone completes it, which is what the audit flagged
/// (FLOW-005: "Do not mark documents as complete merely because a checklist
/// item was created").
model OnboardingChecklistItem {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// PASS | VISA | PASSPORT | EMIRATES_ID | MEDICAL_INSURANCE | ILOE_INSURANCE | BANK | OFFER_LETTER | APPOINTMENT_LETTER | EQUIPMENT | POLICY_ACK
  category    String
  label       String
  required    Boolean   @default(true)
  /// PENDING | IN_PROGRESS | COMPLETED | WAIVED | BLOCKED
  status      String    @default("PENDING")
  /// Set only when a document was actually received and checked. A created
  /// requirement never satisfies itself.
  documentRef String?
  verifiedBy  String?
  verifiedAt  DateTime?
  notes       String?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // One row per category per employee: makes `ensureChecklist` idempotent even
  // under concurrent calls. Added by migration, not by `db push`, so no data is
  // at risk.
  @@unique([employeeId, category])
  @@index([employeeId, status])
  @@index([employeeId, category])
}

model OffboardingRequest {
  id              String                     @id @default(cuid())
  employeeId      String
  employee        Employee                   @relation(fields: [employeeId], references: [id])
  status          String                     @default("REQUESTED") // REQUESTED, IN_REVIEW, NOTICE_PERIOD, CLEARANCE, SETTLEMENT_PENDING, COMPLETED, CANCELLED
  lastWorkingDay  DateTime
  noticePeriodEnd DateTime?
  reason          String?
  exitNotes       String?
  initiatedBy     String
  approvedBy      String?
  completedAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  checklist       OffboardingChecklistItem[]
  settlement      FinalSettlement?

  @@index([employeeId])
  @@index([status])
}

/// Exit checklist. Separate from the checklist item existing state: a created
/// requirement is never treated as a completed one.
model OffboardingChecklistItem {
  id            String             @id @default(cuid())
  offboardingId String
  offboarding   OffboardingRequest @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  label         String
  category      String             @default("GENERAL")
  status        String             @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, WAIVED, BLOCKED
  required      Boolean            @default(true)
  completedBy   String?
  completedAt   DateTime?
  notes         String?
  dueAt         DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([offboardingId, status])
}

/// Company property. Minimal structure — the minimum needed to record an
/// assignment and a return, not a duplicate asset-management system.
// ─── P1 JOINING & PROBATION ───────────────────────────────────────────────────

/// The explicit joining step (brief §18). An employee appearing in the system
/// is the outcome of this record, not an implicit side-effect.
model JoiningRecord {
  id               String       @id @default(cuid())
  candidateId      String
  candidate        Candidate    @relation(fields: [candidateId], references: [id])
  applicationId    String
  application      Application  @relation(fields: [applicationId], references: [id])
  /// Set once the hire has actually joined. Nullable because a joining can be
  /// scheduled before the person arrives.
  employeeId       String?
  employee         Employee?    @relation(fields: [employeeId], references: [id])
  offerId          String?
  offer            OfferLetter? @relation(fields: [offerId], references: [id])
  joiningDate      DateTime
  /// SCHEDULED | JOINED | NO_SHOW | POSTPONED | CANCELLED
  status           String       @default("SCHEDULED")
  department       String?
  designation      String?
  employeeCode     String?
  probationEndDate DateTime?
  actualJoinedAt   DateTime?
  joinedBy         String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([candidateId])
  @@index([joiningDate])
}

/// Probation tracking (brief §21). Created automatically at joining when the
/// accepted offer carried a probation period.
model ProbationReview {
  id                    String    @id @default(cuid())
  employeeId            String
  employee              Employee  @relation(fields: [employeeId], references: [id])
  startDate             DateTime
  endDate               DateTime
  /// NOT_STARTED | IN_PROGRESS | CONFIRMED | EXTENDED | FAILED
  status                String    @default("NOT_STARTED")
  managerId             String?
  reviewDate            DateTime?
  performanceRating     Float?
  attendanceRating      Float?
  conductRating         Float?
  technicalRating       Float?
  communicationRating   Float?
  teamworkRating        Float?
  overallRecommendation String? // CONFIRM, EXTEND, TERMINATE
  comments              String?
  hrApprovedBy          String?
  hrApprovedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([endDate])
}

model Asset {
  id           String            @id @default(cuid())
  assetTag     String            @unique
  name         String
  category     String?
  serialNumber String?
  description  String?
  condition    String            @default("GOOD") // NEW, GOOD, FAIR, DAMAGED, LOST
  status       String            @default("AVAILABLE") // AVAILABLE, ASSIGNED, RETURNS_DUE, RETIRED
  purchaseDate DateTime?
  value        Float?
  currency     String            @default("AED")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  AssetAssignment[]
}

/// An asset cannot be assigned to two people at once: enforced by a partial
/// unique index created in the migration, not by application code alone.
model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  assignedAt DateTime  @default(now())
  assignedBy String
  returnedAt DateTime?
  returnedTo String?
  condition  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, returnedAt])
  @@index([assetId, returnedAt])
}

/// Final settlement. Intentionally NOT a UAE end-of-service calculator: the
/// business rules are not defined in this codebase, so the workflow is built
/// and the arithmetic is left as explicit, reviewable inputs.
model FinalSettlement {
  id                    String             @id @default(cuid())
  offboardingId         String             @unique
  offboarding           OffboardingRequest @relation(fields: [offboardingId], references: [id])
  status                String             @default("DRAFT") // DRAFT, CALCULATED, UNDER_REVIEW, APPROVED, PAID
  pendingSalaryDays     Float              @default(0)
  pendingSalaryAmount   Float              @default(0)
  leaveEncashmentDays   Float              @default(0)
  leaveEncashmentAmount Float              @default(0)
  loanDeductions        Float              @default(0)
  advanceDeductions     Float              @default(0)
  otherDeductions       Float              @default(0)
  otherAdditions        Float              @default(0)
  gratuityAmount        Float              @default(0)
  finalAmount           Float              @default(0)
  calculationNotes      String?
  approvedBy            String?
  approvedAt            DateTime?
  paidAt                DateTime?
  paidReference         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

/// Configurable leave policy (P1.3). Nothing about entitlement is hardcoded.
model LeaveAccrualPolicy {
  id                    String            @id @default(cuid())
  leaveType             String
  annualEntitlement     Int               @default(0)
  accrualFrequency      String            @default("ANNUAL") // MONTHLY, ANNUAL, MANUAL
  accrualAmount         Int               @default(0)
  carryForward          Boolean           @default(false)
  maximumBalance        Int?
  /// Manager approval alone finalises leave of this many days or fewer;
  /// anything longer also requires HR review. Configurable, not hardcoded.
  hrReviewThresholdDays Int               @default(5)
  requiresHrReview      Boolean           @default(true)
  effectiveFrom         DateTime          @default(now())
  effectiveTo           DateTime?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  accrualRuns           LeaveAccrualRun[]

  @@unique([leaveType, effectiveFrom])
  @@index([leaveType, isActive])
}

/// One row per policy per period makes accrual idempotent: a unique constraint
/// on (employeeId, policyId, period) means a second run for the same period
/// cannot double-credit anyone, even under concurrency.
model LeaveAccrualRun {
  id           String             @id @default(cuid())
  policyId     String
  policy       LeaveAccrualPolicy @relation(fields: [policyId], references: [id])
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id])
  period       String // e.g. 2026-01 or 2026
  daysCredited Int                @default(0)
  daysCarried  Int                @default(0)
  balanceAfter Int                @default(0)
  status       String             @default("APPLIED") // APPLIED, SKIPPED
  skipReason   String?
  createdBy    String?
  createdAt    DateTime           @default(now())

  @@unique([employeeId, policyId, period])
  @@index([period])
}

/// Registered biometric terminal (P1.7, FLOW-025). The API secret is stored as
/// a SHA-256 hash only; the plaintext is shown once at creation and never again.
model AttendanceDevice {
  id               String              @id @default(cuid())
  name             String
  deviceIdentifier String              @unique
  location         String?
  status           String              @default("ACTIVE") // ACTIVE, DISABLED, REVOKED
  apiKeyHash       String              @unique
  keyPrefix        String // short public prefix, safe to display
  lastSyncAt       DateTime?
  lastSyncRecords  Int                 @default(0)
  createdBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  syncLogs         AttendanceSyncLog[]
}

/// Per-import outcome, so operators can see accepted / rejected / duplicate
/// counts without exposing any credential.
model AttendanceSyncLog {
  id               String           @id @default(cuid())
  deviceId         String
  device           AttendanceDevice @relation(fields: [deviceId], references: [id])
  fileName         String?
  totalRows        Int              @default(0)
  imported         Int              @default(0)
  duplicates       Int              @default(0)
  rejected         Int              @default(0)
  unknownEmployees Int              @default(0)
  durationMs       Int?
  errorSummary     String?
  createdAt        DateTime         @default(now())

  @@index([deviceId, createdAt])
}

/// One row per document per reminder window. The unique constraint is what
/// makes "do not send the same reminder twice" a database guarantee (P1.6).
model DocumentExpiryReminder {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  documentType  String // VISA, PASSPORT, EMIRATES_ID, MEDICAL_INSURANCE, WORK_PERMIT, ILOE_INSURANCE
  documentId    String?
  thresholdDays Int
  expiryDate    DateTime
  recipientRole String   @default("EMPLOYEE") // EMPLOYEE, HR, MANAGER
  sentAt        DateTime @default(now())
  deliveryId    String?

  @@unique([employeeId, documentType, thresholdDays, expiryDate])
  @@index([expiryDate])
}

/// Renewal workflow for an expiring document. Previous document history is
/// never deleted.
model DocumentRenewal {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  documentType  String
  currentExpiry DateTime
  status        String    @default("REQUESTED") // REQUESTED, DOCUMENT_SUBMITTED, UNDER_REVIEW, RENEWED, REJECTED, CANCELLED
  newExpiry     DateTime?
  notes         String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, status])
}

/// Payroll run header. Per-employee results stay in SalaryRecord; this tracks
/// the period lifecycle and makes locking and duplicate prevention explicit.
model PayrollRun {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  status          String    @default("DRAFT") // DRAFT, CALCULATING, CALCULATED, UNDER_REVIEW, APPROVED, LOCKED, PAID, CANCELLED
  employeeCount   Int       @default(0)
  totalNet        Float     @default(0)
  totalDeductions Float     @default(0)
  lockedAt        DateTime?
  lockedBy        String?
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  paidReference   String?
  failureCount    Int       @default(0)
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([year, month])
  @@index([status])
}

/// Notification delivery attempts. Kept SEPARATE from Notification so a failed
/// email can never roll back the business transaction that created the record
/// (P1.8).
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String?
  channel        String // IN_APP, EMAIL, SMS
  recipient      String
  templateKey    String?
  status         String    @default("PENDING") // PENDING, SENT, FAILED, RETRYING, SKIPPED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastError      String?
  externalId     String?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([recipient])
}

/// The existing AuditLog model requires an employeeId, which makes it
/// unsuitable for events that are not about one employee (role changes,
/// denied requests, seed attempts, sign-in failures).
model SecurityAuditLog {
  id            String   @id @default(cuid())
  action        String
  actorEmail    String?
  actorRole     String?
  target        String?
  outcome       String   @default("SUCCESS") // SUCCESS, DENIED, ERROR
  detail        Json?
  requestPath   String?
  requestMethod String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([actorEmail])
  @@index([createdAt])
}


model TravelAllowanceRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  amount      Decimal
  description String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  approvedBy  String?
}

model Employee {
  // existing fields ...
  // New relationship for travel allowance requests (one‑off)
  travelAllowanceRequests TravelAllowanceRequest[]

  id                     String    @id @default(cuid())
  /// P1 GAP-01: nullable so an employee can be created before their login is
  /// provisioned or their visa is processed. A CHECK constraint
  /// (Employee_active_requires_employment_data) requires the full set once
  /// lifecycle is ACTIVE/CONFIRMED/PROBATION. Prisma cannot express CHECK
  /// constraints, so that guarantee lives in SQL only — see
  /// docs/audit/GAP01_MIGRATION_REVIEW.md
  userId                 String?   @unique
  user                   User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeCode           String?   @unique // Auto-generated: EMP-001
  firstName              String
  lastName               String
  email                  String    @unique
  rollNumber             String    @unique
  photo                  String?
  phone                  String?
  gender                 String?
  bloodGroup             String?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          String?
  designation            String?
  department             String?
  joiningDate            DateTime?
  employmentType         String    @default("FULL_TIME")
  workLocation           String?
  probationDays          Int       @default(90)
  currentStatus          String    @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  isActive               Boolean   @default(true)
  address                String?
  permanentAddress       String?
  emergencyContact       String?
  emergencyPhone         String?
  governmentId           String?
  bankName               String?
  accountNumber          String?
  iban                   String?
  ifscCode               String?
  basicSalary            Float?
  housingAllowance       Float?
  transportAllowance     Float?
  otherAllowance         Float?
  passportNumber         String?
  passportExpiry         DateTime?
  emiratesId             String?
  emiratesIdExpiry       DateTime?
  visaNumber             String?
  visaExpiry             DateTime?
  visaType               String?
  medicalInsuranceExpiry DateTime?
  iloeInsuranceExpiry    DateTime?
  labourCardNumber       String?
  labourCardExpiry       DateTime?
  residencePermitNumber  String?
  residencePermitExpiry  DateTime?

  // --- Business travel / air ticket entitlement (UAE) ---
  /// Date the current residence visa was issued or last renewed.
  ///
  /// WHY THIS COLUMN EXISTS: the row previously stored only `visaExpiry`, but
  /// the air ticket entitlement is anchored to the visa RENEWAL date, not the
  /// calendar year. Without the issue date the anchor cannot be derived, so it
  /// is persisted here rather than being inferred once and thrown away. The
  /// compliance feature keeps both dates together; see app/visa.
  visaIssueDate DateTime?

  /// Number of return air tickets the employee may consume per entitlement
  /// year. 0 (the default) means no entitlement.
  ///
  /// THIS IS NOT `SalaryStructure.travelAllowance`, which is a MONTHLY cash
  /// amount paid with payroll. Repurposing that column would silently change a
  /// salary component into a flight allowance, so the entitlement is counted in
  /// whole tickets on its own integer column.
  airTicketEntitlementPerYear Int       @default(0)
  /// ECONOMY | PREMIUM_ECONOMY | BUSINESS — the cabin the entitlement buys.
  /// NULL means no class has been agreed; HR must choose one before an
  /// entitlement is usable.
  airTicketTravelClass        String?
  /// Day the entitlement year resets. Linked to visa renewal: a visa issued on
  /// the 15th resets the entitlement on the 15th, so the window runs 15 Sep to
  /// 14 Sep rather than 1 Jan to 31 Dec.
  ///
  /// NULL means "not yet linked to a visa" and the window falls back to the
  /// calendar year; `lib/workflow/business-travel.ts` reports that state rather
  /// than hiding it.
  airTicketAnchorDate         DateTime?

  /// Monetary cap on company-funded travel, in AED, per entitlement window.
  ///
  /// THE TICKET COUNT IS NOT A MONEY CAP. `airTicketEntitlementPerYear` answers
  /// "how many flights", which says nothing about what a fare may cost: two
  /// economy tickets to the same city can differ fourfold between seasons. This
  /// column is the amount the company has actually committed for the window, and
  /// `grantTravelAmount` refuses a grant above what is left of it unless an
  /// approver records an override.
  ///
  /// DECIMAL, NOT FLOAT, DESPITE THE PAYROLL COLUMNS. `SalaryStructure`'s
  /// component columns are `Float`, and this deliberately does not copy them:
  /// binary floating point cannot represent 0.1, so a budget summed across a
  /// window drifts by fractions of a fils and the operator is told a cap that
  /// does not match the ledger. Money is exact here and rounded only for display.
  ///
  /// It shares `airTicketAnchorDate`'s window on purpose. The ticket count and
  /// the money reset together, so a window can never carry a fresh allowance
  /// against a spent budget.
  ///
  /// NULL means no monetary cap has been agreed. That is NOT unlimited: HR has
  /// simply not set one, and every grant is then over budget by definition, so
  /// approving one is a recorded override.
  annualTravelBudget Decimal?

  shiftId       String?
  shift         Shift?         @relation(fields: [shiftId], references: [id])
  leaveRequests LeaveRequest[]

  // --- P1 workflow relations ---
  offboardingRequests OffboardingRequest[]
  assetAssignments    AssetAssignment[]
  accrualRuns         LeaveAccrualRun[]
  expiryReminders     DocumentExpiryReminder[]
  probationReviews    ProbationReview[]
  joiningRecords      JoiningRecord[]
  onboardingChecklist OnboardingChecklistItem[]

  // --- P1 lifecycle (brief §40) ---
  /// Explicit employment stage. A single ACTIVE/RESIGNED flag cannot express
  /// probation, notice period or exit, so the stage is a separate field:
  /// PRE_JOINING | ACTIVE | PROBATION | CONFIRMED | ON_LEAVE |
  /// NOTICE_PERIOD | RESIGNED | TERMINATED | EXITED
  lifecycle             String                  @default("PRE_JOINING")
  /// Retention tombstone (RET-001). NULL for every live employee.
  ///
  /// WHY THIS COLUMN EXISTS — UAE employment law requires the employer to
  /// retain an employee's records for five years after the employment
  /// relationship ends, so `deleteEmployee` must never issue a `DELETE`. It
  /// archives instead: one guarded write sets `deletedAt` AND `isActive = false`
  /// together, so the row stops appearing in operational reads without its
  /// payroll history, letters, leave records or audit trail being destroyed.
  ///
  /// NOT THE SAME AXIS AS `lifecycle` / `currentStatus`. Those two record what
  /// HAPPENED to the employment relationship (ACTIVE, RESIGNED, TERMINATED) and
  /// archive deliberately does not touch them: archiving is a data-custody
  /// decision, an exit is an HR fact, and conflating them would make an
  /// archived-but-active record indistinguishable from a terminated one.
  /// `isActive` is what operational queries read, so archive sets it as well.
  ///
  /// `@@index([deletedAt])` because every listing now filters on it, and a
  /// nullable-column index is what keeps `WHERE "deletedAt" IS NULL` from
  /// degrading into a sequential scan as the table grows. Postgres indexes
  /// NULLs, so the same index serves both "live rows only" and "archived rows
  /// only" reads without a partial index.
  deletedAt             DateTime?
  /// Provenance. Retained so a recruitment hire stays traceable to the
  /// requisition, application and offer it came from.
  sourceRequisitionId   String?
  sourceCandidateId     String?
  documentRenewals      DocumentRenewal[]
  leaveBalances         LeaveBalance[]
  attendance            Attendance[]
  travelRequests        BusinessTravelRequest[]
  airTicketEntitlements AirTicketEntitlement[]
  salaryStructure       SalaryStructure?
  salaryRecords         SalaryRecord[]
  letterRecords         LetterRecord[]
  serviceRequests       ServiceRequest[]
  visaRequests          VisaRequest[]
  letters               Letter[]
  letterRequests        LetterRequest[]
  attachments           Attachment[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  loanApplications      LoanApplication[]
  overtime              Overtime[]
  salaryAdvances        SalaryAdvanceRequest[]
  reimbursements        ReimbursementRequest[]

  // --- Multi-tenant relations ---
  tenantId          String?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId        String?
  location          Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId      String?
  departmentRel     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // --- Training relations (employee as participant) ---
  trainingEnrollments        TrainingEnrollment[]
  trainingAttendances        TrainingAttendance[]
  trainingCertificates       TrainingCertificate[]
  trainingAssessmentAttempts TrainingAssessmentAttempt[]
  employeeTrainingSkills     EmployeeTrainingSkill[]
  promotions                 EmployeePromotion[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  managerId             String?
  manager               Employee?               @relation("ManagerToStaff", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportees             Employee[]              @relation("ManagerToStaff")
  requestedJobs         JobRequisition[]        @relation("RequestedJobs")
  changeRequests        EmployeeChangeRequest[]
  /// P1: the interviewer relation moved to `InterviewParticipant` so a panel
  /// can have many interviewers. This now points at the join.
  interviewPanel        InterviewParticipant[]

  // --- Exit lifecycle (brief: resignation / termination / end of contract) ---
  /// One case per exit. A second live case is refused by the action, not by a
  /// unique constraint, so the error can name the case that is already open.
  exitCases                   ExitCase[]
  /// Prior-employer rehire assessments. Points at the employee who LEFT, not
  /// at the one who came back.
  rehireRecords               RehireRecord[]
  performanceReviewsAsSubject PerformanceReview[] @relation("PerformanceSubject")
  performanceReviewsAsManager PerformanceReview[] @relation("PerformanceManager")

  // --- Indexes (P0-13) ---
  // Filters: active-employee dropdowns (attendance, shifts, payroll) and department scope.
  @@index([isActive])
  @@index([department, isActive])
  @@index([currentStatus])
  // RET-001: `WHERE "deletedAt" IS NULL` on every operational listing, and
  // `IS NOT NULL` on the archived-records view. Nullable-column B-tree, so one
  // index serves both directions.
  @@index([deletedAt])
  // The archived view is always ordered newest-archive-first and always
  // department-scoped for a MANAGER, so the composite index matches the only
  // query that reads it.
  @@index([department, deletedAt])
}

// ─── LEAVE BALANCE (Auto-created on employee onboarding) ─────────────────────
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
