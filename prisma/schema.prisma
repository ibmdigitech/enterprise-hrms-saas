// ─── LETTERS ──────────────────────────────────────────────────────────────────
model LetterRecord {
  id            String    @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  type          String
  recipientName String
  details       String?
  generatedAt   DateTime  @default(now())

  // --- P1.5 approval + versioning ---
  // A corrected letter creates a NEW row with the next version number. Rows are
  // never overwritten, so the full history of what was issued when is retained.
  /// Stable identity shared by every version of the same logical document.
  documentKey      String    @default("")
  version          Int       @default(1)
  status           String    @default("GENERATED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, GENERATED, VOID
  requiresApproval Boolean   @default(false)
  requestedById    String?
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String?
  voidedAt         DateTime?
  voidReason       String?
  supersededById   String?

  @@index([documentKey, version])
  @@index([employeeId, type])
  @@index([status])
}

model LetterRequest {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  templateId      String
  template        LetterTemplate   @relation(fields: [templateId], references: [id])
  reason          String?
  status          String           @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, COMPLETED, REJECTED
  approvals       LetterApproval[]
  generatedLetter Letter?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model LetterApproval {
  id              String        @id @default(cuid())
  letterRequestId String
  letterRequest   LetterRequest @relation(fields: [letterRequestId], references: [id], onDelete: Cascade)
  approverId      String?
  level           String // MANAGER, HR
  action          String // APPROVED, REJECTED
  comments        String?
  createdAt       DateTime      @default(now())
}

model LetterTemplate {
  id         String          @id @default(cuid())
  name       String
  type       String
  content_en String
  content_ar String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  letters    Letter[]
  requests   LetterRequest[]
}

model Letter {
  id               String          @id @default(cuid())
  /// P1 §15/§19: a letter may belong to a CANDIDATE (an offer letter is issued
  /// before the person becomes an Employee), so the employee link is optional.
  /// A letter is only required to have one of employeeId / candidateId.
  employeeId       String?
  employee         Employee?       @relation(fields: [employeeId], references: [id])
  /// Set when this letter was issued against a recruitment offer.
  candidateId      String?
  candidate        Candidate?      @relation(fields: [candidateId], references: [id])
  templateId       String
  template         LetterTemplate  @relation(fields: [templateId], references: [id])
  referenceNumber  String          @unique
  letterRequestId  String?         @unique
  letterRequest    LetterRequest?  @relation(fields: [letterRequestId], references: [id])
  /// The offer this letter documents, if any. Reverse side of
  /// `OfferLetter.letterRecord`.
  issuedForOffer   OfferLetter[]
  status           String          @default("DRAFT")
  content_en       String
  content_ar       String?
  pdfUrl           String?
  comments         String?
  approvedBy       String?
  approvedAt       DateTime?
  /// The job this offer letter was issued against, if any.
  jobRequisition   JobRequisition? @relation(fields: [jobRequisitionId], references: [id])
  jobRequisitionId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ─── SYSTEM CONFIG ────────────────────────────────────────────────────────────
model ServiceConfig {
  id          String   @id @default(cuid())
  module      String
  key         String
  label       String
  description String?
  type        String
  value       String
  options     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, key])
}

// ─── RECRUITMENT & ONBOARDING ──────────────────────────────────────────────────
model JobRequisition {
  id                    String    @id @default(cuid())
  /// REQ-2026-0001. Unique so a requisition is addressable in approvals.
  requisitionCode       String?   @unique
  title                 String
  department            String
  branch                String?
  location              String?
  employmentType        String    @default("FULL_TIME")
  positionsCount        Int       @default(1)
  /// NEW_POSITION | REPLACEMENT
  positionType          String    @default("NEW_POSITION")
  /// Set when positionType is REPLACEMENT.
  replacementEmployeeId String?
  reason                String?
  requiredSkills        String?
  requiredExperience    String?
  requiredEducation     String?
  budget                Float?
  minSalary             Float?
  maxSalary             Float?
  /// LOW | MEDIUM | HIGH | URGENT
  priority              String    @default("MEDIUM")
  targetJoiningDate     DateTime?
  /// DRAFT | SUBMITTED | MANAGER_REVIEW | HR_REVIEW | FINANCE_REVIEW | APPROVED | REJECTED | CANCELLED
  status                String    @default("DRAFT")
  managerApprovedById   String?
  managerApprovedAt     DateTime?
  hrApprovedById        String?
  hrApprovedAt          DateTime?
  financeApprovedById   String?
  financeApprovedAt     DateTime?
  approvedAt            DateTime?

  requestedById String
  requestedBy   Employee      @relation("RequestedJobs", fields: [requestedById], references: [id])
  /// Replaces the old `candidates` direct relation.
  applications  Application[]
  /// Offer letters issued against a vacancy on this requisition.
  offerLetters  Letter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([department])
}

// ─── RECRUITMENT (P1) ────────────────────────────────────────────────────────
// Restructured. The previous shape had `Candidate.jobId` REQUIRED, which made
// "a candidate may apply to multiple jobs" impossible, and no Application
// entity at all, so the pipeline state machine had nowhere to live.

model Candidate {
  id               String          @id @default(cuid())
  /// Stable external reference, e.g. CAND-0001.
  candidateCode    String?         @unique
  firstName        String
  lastName         String
  email            String          @unique
  phone            String?
  nationality      String?
  currentLocation  String?
  resumeUrl        String?
  /// Private uploaded PDF resume; served only to users with recruitment access.
  resumeData       Bytes?
  resumeFileName   String?
  /// Comma-separated skills; a dedicated join table is a later refinement.
  skills           String?
  currentEmployer  String?
  currentPosition  String?
  expectedSalary   Float?
  noticePeriodDays Int?
  availableFrom    DateTime?
  /// CAREER_PAGE | REFERRAL | LINKEDIN | JOB_PORTAL | AGENCY | DIRECT | EMPLOYEE_REFERRAL | OTHER
  source           String          @default("DIRECT")
  tags             String?
  notes            String?
  /// Data-processing consent. Applications are refused without it.
  consentGiven     Boolean         @default(false)
  consentAt        DateTime?
  /// A candidate is a person; a job is a role. They are linked by Application.
  /// Letters of which this candidate is the subject (offer letters).
  letters          Letter[]
  applications     Application[]
  interviews       Interview[]
  offers           OfferLetter[]
  joiningRecords   JoiningRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([source])
}

/// One application: a Candidate applying to one JobRequisition.
/// This is where the pipeline state lives (brief §6).
model Application {
  id               String         @id @default(cuid())
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRequisitionId String
  jobRequisition   JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)

  /// APPLIED | SCREENING | SHORTLISTED | INTERVIEW | ASSESSMENT | SELECTED |
  /// OFFERED | OFFER_ACCEPTED | OFFER_DECLINED | REJECTED | WITHDRAWN | HIRED
  status                  String    @default("APPLIED")
  /// Snapshot of screening answers (brief §7).
  screeningStatus         String?
  screeningNotes          String?
  /// SHORTLIST | HOLD | REJECT
  screeningRecommendation String?
  screenedBy              String?
  screenedAt              DateTime?
  rating                  Float?
  appliedAt               DateTime  @default(now())
  lastTransitionAt        DateTime  @default(now())
  decidedAt               DateTime?

  interviews     Interview[]
  assessments    Assessment[]
  offers         OfferLetter[]
  joiningRecords JoiningRecord[]

  /// A candidate may not hold two live applications for the SAME job, but may
  /// hold many across different jobs. Enforced by a partial unique index
  /// created in migration, not by application code alone.
  @@unique([candidateId, jobRequisitionId])
  @@index([jobRequisitionId, status])
  @@index([candidateId, status])
}

model Interview {
  id            String                 @id @default(cuid())
  candidateId   String
  candidate     Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// The panel is a first-class join (brief §11), not a single interviewerId.
  interviewers  InterviewParticipant[]
  applicationId String?
  application   Application?           @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// HR | TECHNICAL | MANAGER | PANEL | FINAL
  interviewType String   @default("HR")
  /// 1-based round. Guards ordering.
  round         Int      @default(1)
  /// ONLINE | ONSITE
  mode          String   @default("ONSITE")
  location      String?
  meetingLink   String?
  scheduledAt   DateTime
  startAt       DateTime
  endAt         DateTime
  coordinatorId String?
  status        String   @default("SCHEDULED")

  feedback  InterviewFeedback[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

/// One row per interviewer. Enables a panel without a schema change.
model InterviewParticipant {
  id              String    @id @default(cuid())
  interviewId     String
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId   String
  /// Denormalised for read convenience; the authority is the Employee record.
  interviewerName String
  employee        Employee? @relation(fields: [interviewerId], references: [id])
  isLead          Boolean   @default(false)
  createdAt       DateTime  @default(now())

  feedback InterviewFeedback[]

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
}

/// Structured, per-interviewer feedback (brief §10).
/// One interviewer can never overwrite another's: the unique key is
/// (participantId), not (interviewId).
model InterviewFeedback {
  id            String               @id @default(cuid())
  interviewId   String
  interview     Interview            @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participantId String
  participant   InterviewParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Each dimension scored 1-5 by the interviewer, not auto-derived.
  technicalSkills Int?
  communication   Int?
  problemSolving  Int?
  domainKnowledge Int?
  teamFit         Int?
  leadership      Int?
  overall         Int?

  strengths      String?
  concerns       String?
  comments       String?
  /// STRONG_HIRE | HIRE | HOLD | NO_HIRE
  recommendation String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One submission per interviewer per interview.
  @@unique([participantId])
  @@index([interviewId])
}

model Assessment {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// TECHNICAL_TEST | PRACTICAL_TEST | WRITTEN_TEST | LANGUAGE_TEST | SKILL_ASSESSMENT
  assessmentType String
  assignedAt     DateTime    @default(now())
  dueAt          DateTime?
  completedAt    DateTime?
  maxScore       Float?
  score          Float?
  /// PASS | FAIL | PENDING
  result         String      @default("PENDING")
  evaluatorId    String?
  attachmentUrl  String?
  comments       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
}

/// Offer. Previously `candidateId` was @unique, which meant a candidate could
/// never receive a second, revised offer. Now versioned (brief §14, §23).
model OfferLetter {
  id            String       @id @default(cuid())
  candidateId   String
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  offeredSalary         Float
  designation           String
  department            String
  joiningDate           DateTime
  /// DRAFT | PENDING_APPROVAL | APPROVED | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  status                String          @default("DRAFT")
  /// Version within one application. Previous versions are never overwritten.
  version               Int             @default(1)
  allowances            Float           @default(0)
  benefits              String?
  probationPeriodMonths Int?
  offerExpiry           DateTime?
  contractType          String?
  offeredById           String?
  approvedById          String?
  approvedAt            DateTime?
  acceptedAt            DateTime?
  declinedAt            DateTime?
  /// ACCEPTED_IN_PERSON | ACCEPTED_ONLINE | ACCEPTED_EMAIL
  acceptanceMethod      String?
  fileUrl               String?
  supersededById        String?
  /// Reuse of the existing Letters engine, not a second PDF pipeline (P1 §15).
  letterRecordId        String?
  letterRecord          Letter?         @relation(fields: [letterRecordId], references: [id])
  joiningRecords        JoiningRecord[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([candidateId, version])
  @@index([status])
  @@index([applicationId])
}

// ─── EXIT LIFECYCLE (resignation / termination / end of contract) ───────────
//
// One exit case per departure, plus the two records that exist only because the
// departure happened: the exit interview and the rehire eligibility decision.
//
// ON DELETE, chosen deliberately (checklist item 6.5 — records being
// destroyed):
//
//   * Nothing is CASCADEd from Employee. Deleting an employee must be REFUSED
//     while an exit case or a rehire assessment exists, not silently take the
//     evidence with it. This is the opposite of `OnboardingChecklistItem`, which
//     cascades: an onboarding checklist is provisioning state, an exit case is a
//     record someone can be held to.
//   * The User actor relations are Restrict, not SetNull. SetNull would quietly
//     erase who approved a termination the moment that administrator's account
//     was removed. The fields are nullable because a case legitimately exists
//     before anyone has decided it, and nullability is what expresses "not
//     decided yet" without a fake value.
//   * The two child tables DO cascade from ExitCase, matching
//     `OffboardingChecklistItem.offboarding`. An exit interview is a component
//     of its case and has no independent owner or meaning, so removing the case
//     removes the component. The case itself is the record that is protected.

/// The departure itself. `status` is a state-machine value, not a free label;
/// the legal moves live in `lib/workflow/exit/state-machine.ts`.
model ExitCase {
  id                    String    @id @default(cuid())
  employeeId            String
  /// Restrict, not Cascade — see the note above. An employee with an exit on
  /// record cannot be deleted; the record outlives any attempt to remove it.
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// RESIGNATION | TERMINATION | END_OF_CONTRACT
  type                  String
  /// REQUESTED, PENDING_APPROVAL, APPROVED, REJECTED, WITHDRAWN, NOTICE_PERIOD,
  /// INTERVIEW_PENDING, INTERVIEW_COMPLETED, CLEARANCE_PENDING,
  /// SETTLEMENT_PENDING, COMPLETED, CANCELLED
  status                String    @default("REQUESTED")
  /// The employee's stated reason, or HR's stated reason for a termination.
  reason                String?
  /// Private resignation letter bytes. Downloads are served through an
  /// authenticated route; this is intentionally not a public uploads URL.
  resignationLetterData Bytes?
  resignationLetterName String?
  resignationLetterType String?
  /// Recorded by the action, not defaulted, so a back-dated request is visible
  /// as back-dated instead of looking like it was raised today.
  requestedAt           DateTime  @default(now())
  /// Contractual end date. Distinct from `lastWorkingDate`: the last day worked
  /// can be shortened by notice, the effective date cannot.
  effectiveDate         DateTime?
  lastWorkingDate       DateTime?
  /// INPUT, NOT A POLICY. Statutory and contractual notice periods differ by
  /// jurisdiction, contract and length of service, so no value is computed
  /// here. Null means "not yet agreed"; the caller must supply it or configure
  /// `EXIT_POLICY.noticePeriodDays` in lib/workflow/exit/state-machine.ts, which
  /// ships unset.
  noticePeriodDays      Int?
  initiatedById         String?
  initiatedBy           User?     @relation("ExitCaseInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedById           String?
  decidedBy             User?     @relation("ExitCaseDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedAt             DateTime?
  /// Why a case was approved, rejected or withdrawn. Kept separate from
  /// `reason`, which describes the departure rather than the decision.
  decisionNote          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  interview ExitInterview?
  rehire    RehireRecord?

  @@index([employeeId])
  @@index([status])
  @@index([status, type])
}

/// The exit interview. `rating` is a raw 1–5 answer supplied by the
/// interviewer; nothing derives from it here, and no default is imposed.
model ExitInterview {
  id            String   @id @default(cuid())
  /// One interview per case. The unique constraint is the database-level
  /// double-submit guard; the action additionally re-validates the case status
  /// inside the transaction before writing.
  exitCaseId    String   @unique
  exitCase      ExitCase @relation(fields: [exitCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conductedById String
  conductedBy   User     @relation("ExitInterviewConductedBy", fields: [conductedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conductedAt   DateTime @default(now())
  /// 1–5, or null when the interview happened but was not scored. Stored as
  /// given: a stored rating is a claim about what the leaver said.
  rating        Int?
  /// NULLABLE ON PURPOSE. Null means the question was not put or was declined.
  /// Defaulting it to false would manufacture a negative answer that HR then
  /// filters rehire candidates on.
  wouldRejoin   Boolean?
  comments      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Whether this former employee may be rehired. Points at the PRIOR employee,
/// so the record survives the person returning under a new Employee row.
model RehireRecord {
  id           String   @id @default(cuid())
  /// The employee who left. Restrict — the assessment is evidence about this
  /// person and must not vanish with them.
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// One eligibility decision per exit. Re-assessment overwrites the row
  /// deliberately (the newest decision is the current one) and every
  /// overwriting write also appends an AuditLog row, so the earlier answer
  /// remains recoverable.
  exitCaseId   String   @unique
  exitCase     ExitCase @relation(fields: [exitCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eligible     Boolean
  assessedAt   DateTime @default(now())
  assessedById String
  assessedBy   User     @relation("RehireAssessedBy", fields: [assessedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, eligible])
}

// ─── PERFORMANCE REVIEW (P2) ────────────────────────────────────────────────────
//
// Performance review cycle and reviews. Built on the same patterns as
// recruitment-machine.ts: explicit state machines, role-based transitions,
// permission-checked workflow functions, and audit logging.

/// Performance review cycle — YEARLY, HALF_YEARLY, QUARTERLY
model PerformanceCycle {
  id                    String   @id @default(cuid())
  name                  String // e.g. "2026 H1", "2026 Q3"
  type                  String // YEARLY | HALF_YEARLY | QUARTERLY
  startDate             DateTime
  endDate               DateTime
  /// PLANNING → ACTIVE → CLOSED → ARCHIVED
  status                String   @default("PLANNING")
  /// Whether self-assessment is enabled for this cycle
  selfAssessmentEnabled Boolean  @default(true)
  /// Whether manager review is enabled
  managerReviewEnabled  Boolean  @default(true)
  /// Whether calibration is enabled
  calibrationEnabled    Boolean  @default(true)
  createdById           String
  createdBy             User     @relation("PerformanceCycleCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  reviews   PerformanceReview[]
  questions PerformanceQuestion[]

  @@unique([type, startDate, endDate])
  @@index([status])
  @@index([startDate, endDate])
}

/// Performance review for an employee within a cycle
model PerformanceReview {
  id               String           @id @default(cuid())
  cycleId          String
  cycle            PerformanceCycle @relation(fields: [cycleId], references: [id])
  employeeId       String
  subject          Employee         @relation("PerformanceSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId        String?
  manager          Employee?        @relation("PerformanceManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// DRAFT → SELF_ASSESSMENT → MANAGER_REVIEW → CALIBRATION → APPROVED → ACKNOWLEDGED
  status           String           @default("DRAFT")
  overallRating    Float? // 1-5 scale
  overallComment   String?
  selfAssessmentAt DateTime?
  managerReviewAt  DateTime?
  calibrationAt    DateTime?
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?            @relation("ReviewApprovedBy", fields: [approvedById], references: [id])
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?            @relation("ReviewAcknowledgedBy", fields: [acknowledgedById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  goals   PerformanceGoal[]
  answers PerformanceAnswer[]

  @@unique([cycleId, employeeId])
  @@index([cycleId, status])
  @@index([employeeId])
  @@index([managerId])
}

/// Performance goal within a review
model PerformanceGoal {
  id          String            @id @default(cuid())
  reviewId    String
  review      PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title       String
  description String?
  weight      Float             @default(1) // Weight for overall rating calculation
  target      String // Expected outcome
  actual      String? // Actual outcome
  rating      Float? // 1-5 scale, rated by manager
  comment     String?
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([reviewId])
}

/// Configurable questions per cycle (competency, behavioral, etc.)
model PerformanceQuestion {
  id         String           @id @default(cuid())
  cycleId    String
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  text       String
  /// KPI | COMPETENCY | BEHAVIORAL | GOAL | OPEN_ENDED
  type       String           @default("COMPETENCY")
  /// EMPLOYEE | MANAGER | BOTH
  audience   String           @default("BOTH")
  weight     Float            @default(1)
  order      Int              @default(0)
  isRequired Boolean          @default(true)
  options    Json? // For rating scale options
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  answers PerformanceAnswer[]

  @@index([cycleId, order])
}

/// Employee/manager answers to questions
model PerformanceAnswer {
  id         String              @id @default(cuid())
  reviewId   String
  review     PerformanceReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  questionId String
  question   PerformanceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// EMPLOYEE | MANAGER
  answeredBy String
  answer     String?
  rating     Float? // 1-5 scale
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([reviewId, questionId, answeredBy])
  @@index([reviewId])
  @@index([questionId])
}

/// Predefined calibration scenarios for consistent ratings
model ReviewScenario {
  id          String   @id @default(cuid())
  name        String // e.g. "Exceeds Expectations", "Meets Expectations", "Needs Improvement"
  description String
  rating      Float // Reference rating 1-5
  behaviors   Json? // Key behaviors for this scenario
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// ─── COMPANY DOCUMENTS & POLICIES ─────────────────────────────────────────────
/// Central repository for company policies, handbooks, procedures, and
/// official documents. Distinct from employee-specific attachments.
model CompanyDocument {
  id            String    @id @default(cuid())
  title         String
  type          String // POLICY | HANDBOOK | PROCEDURE | FORM | OTHER
  category      String // HR | FINANCE | IT | LEGAL | GENERAL
  description   String?
  fileUrl       String
  fileName      String
  fileType      String
  /// Private uploaded PDF; served through an authenticated route.
  fileData      Bytes?
  fileBytes     Int?     // File size in bytes for storage calculation
  version       String    @default("1.0")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  publishedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category, isActive])
  @@index([type])
}

// ─── EMPLOYEE DATA CHANGE REQUESTS (Maker-Checker) ───────────────────────────
model EmployeeChangeRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  /// A JSON object containing the proposed changes, e.g. { "passportNumber": "A123", "address": "Dubai" }
  changes Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents ChangeRequestDocument[]

  @@index([employeeId, status])
  @@index([status])
}

model ChangeRequestDocument {
  id           String                @id @default(cuid())
  requestId    String
  request      EmployeeChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentType String // VISA, PASSPORT, EMIRATES_ID, ADDRESS_PROOF
  documentUrl  String
  createdAt    DateTime              @default(now())
}

// ─── BUSINESS TRAVEL & AIR TICKET ENTITLEMENT (UAE) ───────────────────────────
/// One company-purpose trip outside the country, requested rather than booked
/// ad hoc.
///
/// The visa columns are SNAPSHOTS, not foreign keys: the employee row is the
/// live visa record and is corrected by the compliance feature, but a travel
/// case must show the visa context the trip was approved under even after the
/// visa has been renewed. Linking to `DocumentRenewal` would couple the travel
/// workflow to the compliance workflow's row ids; the snapshot is enough to
/// answer "was this trip inside the visa window?", which is the actual question.
model BusinessTravelRequest {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  purpose            String
  destinationCountry String
  destinationCity    String?
  departureDate      DateTime
  returnDate         DateTime?
  /// Budget or quoted fare. AED is implicit: the company operates in the UAE
  /// and there is no multi-currency settlement, so a second currency column
  /// would be an unused field to keep consistent.
  estimatedCost      Float     @default(0)
  /// What HR agreed to pay, set by `grantTravelAmount`.
  ///
  /// SEPARATE FROM `estimatedCost` ON PURPOSE, AND SEPARATE AGAIN IN TYPE. The
  /// estimate is the TRAVELLER'S QUOTE and is typed `Float` because it is a
  /// free-text number from a form. The approved amount is a COMPANY COMMITMENT,
  /// compared against a budget and summed across a window, so it is `Decimal`
  /// and a `Float` variant of the same column would be a rounding dispute
  /// waiting to happen. HR grants the amount after reviewing the quote, and the
  /// two are allowed to disagree: `budgetVariance` records by how much.
  approvedAmount     Decimal?
  /// approvedAmount - estimatedCost, stored rather than derived at render time.
  ///
  /// A negative variance means the company is paying LESS than the traveller
  /// quoted, which is a conversation worth having before the trip rather than a
  /// footnote on the request. Persisting it keeps the figure on the row that
  /// decided it, so an audit does not have to re-derive it from a quote that HR
  /// may later have corrected.
  budgetVariance     Decimal?
  /// Who set `approvedAmount` and when. An amount with no author cannot be
  /// audited, and "who agreed to this spend" is the first question asked of any
  /// travel budget.
  amountGrantedBy    String?
  amountGrantedAt    DateTime?
  /// ECONOMY | PREMIUM_ECONOMY | BUSINESS — what was asked for, which may be
  /// above the employee's entitled class and is refused on approval if so.
  travelClass        String    @default("ECONOMY")
  /// COMPANY | EMPLOYEE — who pays. A trip the employee asked for personally is
  /// not a company obligation, so this is recorded rather than assumed.
  ticketCostBorneBy  String    @default("COMPANY")
  status             String    @default("REQUESTED") // REQUESTED, PENDING_APPROVAL, APPROVED, REJECTED, COMPLETED, CANCELLED

  /// Visa context at the moment the request was raised.
  visaNumberSnapshot String?
  visaExpirySnapshot DateTime?
  visaIssueSnapshot  DateTime?

  /// The entitlement window this request draws a ticket from, resolved once at
  /// creation from `Employee.airTicketAnchorDate`. Stored so that completing
  /// the request months later still increments the window it was granted under,
  /// rather than whichever window happens to be open on the day it is flown.
  entitlementId          String?
  entitlement            AirTicketEntitlement? @relation(fields: [entitlementId], references: [id])
  entitlementWindowKey   String?
  entitlementWindowStart DateTime?
  entitlementWindowEnd   DateTime?

  requestedBy  String
  reviewedBy   String?
  reviewedAt   DateTime?
  decisionNote String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Ticket and boarding pass filed against THIS trip. Cascaded with the request,
  /// because a document whose journey has been deleted is meaningless.
  documents TravelDocument[]

  // --- Indexes ---
  // The register lists an employee's history newest-first.
  @@index([employeeId, createdAt])
  // Approval queues filter on status; the visa page joins travel to expiry.
  @@index([status])
  @@index([status, departureDate])
  @@index([entitlementId])
}

/// Per-employee ledger for ONE entitlement window.
///
/// The "1 or 2 tickets per year" cap is answered by `usedTickets` on this row,
/// and the row is keyed by (employee, window) so a question about a past window
/// stays answerable after the window has rolled over.
///
/// The key is the window's START DATE, not a year number, because the window is
/// anchored to the visa date: an anchor of 15 Sep 2026 gives windows keyed
/// "2026-09-15" and "2027-09-15", neither of which is the calendar year.
model AirTicketEntitlement {
  id                String                  @id @default(cuid())
  employeeId        String
  employee          Employee                @relation(fields: [employeeId], references: [id])
  /// `yyyy-MM-dd` of `windowStart`. Stable, sortable, and independent of the
  /// label an operator happens to type.
  windowKey         String
  windowStart       DateTime
  /// INCLUSIVE last day of the window. For a 15 Sep anchor that is 14 Sep of
  /// the following year, not 15 Sep — see lib/workflow/business-travel.ts.
  windowEnd         DateTime
  /// Entitlement as it stood when this window opened. Denormalised so a later
  /// change to the employee's contract cannot retroactively rewrite history.
  entitledTickets   Int                     @default(0)
  /// Tickets actually consumed. Incremented exactly once per request, inside the
  /// same transaction that moves the request to COMPLETED, with a
  /// compare-and-swap predicate so a double click cannot consume two tickets.
  usedTickets       Int                     @default(0)
  /// The anchor date this window was derived from, recorded so an audit can
  /// reproduce the boundary years later even if the visa is later corrected.
  anchorSnapshot    DateTime?
  anchorSource      String? // EXPLICIT | VISA_ISSUE_DATE | CALENDAR_YEAR_FALLBACK
  /// Requests that draw a ticket from this window. A window can back several
  /// requests (a 2-ticket employee), so this is one-to-many, not one-to-one.
  consumingRequests BusinessTravelRequest[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  /// One ledger row per employee per window. The uniqueness is what makes the
  /// cap a database fact rather than a read-then-write race.
  @@unique([employeeId, windowKey])
  @@index([employeeId, windowStart])
}

/// Supporting documents for ONE business travel request.
///
/// WHY THIS IS NOT THE SHARED `Attachment` MODEL
/// `Attachment` hangs off an Employee and describes a document of record —
/// passport, visa, contract — which persists independently of any one request.
/// A ticket and a boarding pass belong to a specific journey: they are
/// meaningless once that request is archived, and the same employee flying next
/// month gets a different pair. Filing them as Employee attachments would make
/// "the employee's current ticket" ambiguous the moment they travel twice.
///
/// The lifecycle differs too, and that is the point of storing them here:
///   - TICKET is proof of booking, so it is expected once the request is
///     APPROVED and before departure.
///   - BOARDING_PASS is proof the employee actually flew, so it is expected by
///     COMPLETED.
/// `lib/workflow/business-travel.ts` enforces those, so a trip cannot be marked
/// complete with nothing to show for it.
///
/// `@@unique([requestId, kind])` makes re-upload an upsert. A corrected boarding
/// pass replaces the wrong one instead of leaving two and making it ambiguous
/// which is authoritative.
model TravelDocument {
  id        String                @id @default(cuid())
  requestId String
  request   BusinessTravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// TICKET | BOARDING_PASS — see TRAVEL_DOCUMENT_KINDS in the workflow module.
  kind String

  fileName  String
  /// A `data:` URL holding the bytes, as `Attachment.fileUrl` does. A boarding
  /// pass is a private document, so it is deliberately NOT written to
  /// `public/uploads`, where anything served from it is readable by anyone who
  /// guesses the filename.
  fileUrl   String
  fileType  String
  fileBytes Int?

  /// Booking reference / PNR. Separate from the file because it is the one
  /// field an approver reads without opening a PDF.
  reference String?

  uploadedBy String
  uploadedAt DateTime @default(now())

  /// Who checked the scan against the journey, and when.
  ///
  /// AN UPLOAD IS NOT A VERIFICATION. These columns are written only by
  /// `verifyTravelDocument`, which a human calls after looking at the file — the
  /// same rule `OnboardingChecklistItem.verifiedBy` follows. An approver must
  /// be able to say which of the two tickets on a trip was the forgery, and a
  /// single `uploadedBy` column cannot answer it.
  ///
  /// `verifiedAt IS NOT NULL` is the ONLY accepted proof, because it is the
  /// state written together with the approver's email and an audit row.
  ///
  /// The upsert on `@@unique([requestId, kind])` CLEARS both on re-upload: a new
  /// scan is a new claim, and leaving the old sign-off behind would let a
  /// replaced document inherit the verification of the one it replaced. That is
  /// the trap `recordDocumentReceived` documents for employee documents.
  verifiedBy String?
  verifiedAt DateTime?

  @@unique([requestId, kind])
  @@index([kind])
}

// ─── SUBSCRIPTION MANAGEMENT ────────────────────────────────────────────────────
model CompanySubscription {
  id                    String   @id @default(cuid())
  planId                String
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id])
  status                String   @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, CANCELLED, EXPIRED
  billingCycle          String   @default("MONTHLY") // MONTHLY, YEARLY
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean  @default(false)
  cancelledAt           DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  provider              String   @default("MANUAL") // MANUAL, STRIPE, PAYPAL
  providerSubscriptionId String?
  providerCustomerId    String?
  employeesCount        Int      @default(0)
  storageUsedMB         Int      @default(0)
  apiCallsThisMonth     Int      @default(0)
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  usageLogs SubscriptionUsageLog[]

  @@index([planId])
  @@index([status])
  @@index([providerSubscriptionId])
}

model SubscriptionUsageLog {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    CompanySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureKey      String
  tokensUsed      Int      @default(0)
  requestsCount   Int      @default(0)
  periodStart     DateTime
  periodEnd       DateTime
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([subscriptionId, featureKey])
  @@index([periodStart, periodEnd])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ─── SAAS MULTI-TENANT & MULTI-COMPANY CORE MODELS ───────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Represents an independent organization/subscriber using the SaaS HRMS.
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // Subdomain: [slug].hrms-saas.com
  legalName    String?
  customDomain String?  @unique
  status       String   @default("TRIAL") // TRIAL, ACTIVE, SUSPENDED, CANCELLED, ARCHIVED
  logoUrl      String?
  primaryColor String?  @default("#1e40af")
  accentColor  String?  @default("#0284c7")
  timezone     String   @default("Asia/Dubai")
  currency     String   @default("AED")
  locale       String   @default("en")
  contactEmail String?
  contactPhone String?
  /// Dedicated PostgreSQL connection string for this tenant (database-per-tenant architecture).
  /// If null, falls back to the default shared tenant pool.
  databaseUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SaaS Hierarchy Relations
  subscription        TenantSubscription?
  memberships         TenantMembership[]
  companies           Company[]
  locations           Location[]
  departments         Department[]
  employees           Employee[]
  invoices            SubscriptionInvoice[]
  paymentTransactions PaymentTransaction[]

  // New Super Admin Relations
  roleRequests        RoleRequest[]
  companyModules      CompanyModule[]
  supportTickets      SupportTicket[]
  integrations        Integration[]
  backgroundJobs      BackgroundJob[]
  integrationHealth   IntegrationHealth[]
  applicationErrors   ApplicationError[]
  aiUsageLogs         AIUsageLog[]
  aiBudget            AICompanyBudget?

  // Training relations
  trainingCourses            TrainingCourse[]
  trainingSessions           TrainingSession[]
  trainingEnrollments        TrainingEnrollment[]
  trainingCertificates       TrainingCertificate[]
  trainingCertificateTemplates TrainingCertificateTemplate[]
  trainingAssessments        TrainingAssessment[]
  trainingSkills             TrainingSkill[]
  trainingCategories         TrainingCategory[]
  employeeTrainingSkills     EmployeeTrainingSkill[]
  promotions                 EmployeePromotion[]
  temporaryRoleAssignments TemporaryRoleAssignment[] @relation("TemporaryRoleAssignmentTenant")

  @@index([slug])
  @@index([status])
}

/// Link between a global User identity and a specific Tenant with scoped roles.
model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Role within this specific tenant: ADMIN, HR, FINANCE, MANAGER, STAFF
  role      String   @default("STAFF")
  /// INVITED, ACTIVE, SUSPENDED, REMOVED
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
}

/// Represents a distinct legal corporate entity owned by a Tenant.
model Company {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  tradeLicenseNumber String?
  taxId              String?
  currency           String   @default("AED")
  logoUrl            String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  locations        Location[]
  departments      Department[]
  employees        Employee[]

  // New Super Admin Relations
  companyModules   CompanyModule[]
  supportTickets   SupportTicket[]
  
  // Training relations
  trainingCourses            TrainingCourse[]
  trainingSessions           TrainingSession[]
  trainingEnrollments        TrainingEnrollment[]
  trainingCertificates       TrainingCertificate[]
  trainingCertificateTemplates TrainingCertificateTemplate[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Represents a physical branch, office or worksite belonging to a Company.
model Location {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?
  city      String?
  state     String?
  country   String   @default("AE")
  timezone  String   @default("Asia/Dubai")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  employees   Employee[]

  @@unique([companyId, name])
  @@index([tenantId])
  @@index([companyId])
}

/// Represents a department or team structure within a Company / Tenant.
model Department {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name       String
  code       String?
  parentId   String?
  parent     Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children   Department[] @relation("DepartmentHierarchy")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  employees Employee[]

  @@unique([companyId, name])
  @@index([tenantId])
  @@index([companyId])
}

/// Global platform subscription tiers and feature catalogs.
model SubscriptionPlan {
  id             String               @id @default(cuid())
  name           String               @unique // Starter, Growth, Enterprise, Custom
  slug           String               @unique // starter, growth, enterprise, custom
  displayName    String
  description    String?
  priceMonthly   Float                @default(0)
  priceAnnual    Float                @default(0)
  priceYearly    Float                @default(0)
  currency       String               @default("AED")
  features       Json?
  maxEmployees   Int                  @default(25)
  maxCompanies   Int                  @default(1)
  maxLocations   Int                  @default(2)
  hasPayroll     Boolean              @default(true)
  hasCompliance  Boolean              @default(true)
  hasRecruitment Boolean              @default(true)
  hasCustomTheme Boolean              @default(false)
  hasApiAccess   Boolean              @default(false)
  isPopular      Boolean              @default(false)
  isActive       Boolean              @default(true)
  isDefault      Boolean              @default(false)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  subscriptions  TenantSubscription[]
  companySubscriptions CompanySubscription[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
}

/// Subscription limits, feature modules, and plan details for a Tenant.
model TenantSubscription {
  id                 String                @id @default(cuid())
  tenantId           String                @unique
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String?
  plan               SubscriptionPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// STARTER, GROWTH, ENTERPRISE, CUSTOM
  planTier           String                @default("TRIAL")
  billingCycle       String                @default("MONTHLY") // MONTHLY, ANNUAL
  maxEmployees       Int                   @default(25)
  maxCompanies       Int                   @default(1)
  maxLocations       Int                   @default(2)
  hasPayroll         Boolean               @default(true)
  hasCompliance      Boolean               @default(true)
  hasRecruitment     Boolean               @default(true)
  hasCustomTheme     Boolean               @default(false)
  hasApiAccess       Boolean               @default(false)
  startsAt           DateTime              @default(now())
  expiresAt          DateTime?
  currentPeriodStart DateTime              @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean               @default(false)
  status             String                @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  invoices           SubscriptionInvoice[]

  @@index([status])
  @@index([planTier])
}

/// Tenant-isolated billing invoice records.
model SubscriptionInvoice {
  id                 String                @id @default(cuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       TenantSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber      String                @unique // INV-2026-0001
  amount             Float
  taxAmount          Float                 @default(0)
  totalAmount        Float
  currency           String                @default("AED")
  status             String                @default("PENDING") // PENDING, PAID, OVERDUE, VOID
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paidAt             DateTime?
  paymentMethod      String?               // CARD, BANK_TRANSFER, MANUAL
  invoicePdfUrl      String?
  notes              String?
  transactions       PaymentTransaction[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

/// Audit-compliant ledger of payment transactions per tenant.
model PaymentTransaction {
  id                 String               @id @default(cuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            SubscriptionInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount             Float
  currency           String               @default("AED")
  status             String               @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  gateway            String               @default("STRIPE")  // STRIPE, NETWORK_INTL, TELR, BANK_TRANSFER, MANUAL
  transactionRef     String               @unique
  paymentMethodType  String?              // VISA, MASTERCARD, BANK_TRANSFER, APPLE_PAY
  lastFour           String?
  rawGatewayResponse Json?
  createdAt          DateTime             @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── SAAS MODULES & ENTITLEMENTS ─────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Represents an available SaaS module/feature in the platform.
model Module {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "payroll", "recruitment", "attendance"
  name        String
  description String?
  category    String   @default("CORE") // CORE, HR, FINANCE, COMPLIANCE, TALENT, OPERATIONS
  isActive    Boolean  @default(true)
  isCore      Boolean  @default(false) // Core modules cannot be disabled
  sortOrder   Int      @default(0)
  priceMonthly Float    @default(0)
  priceAnnual  Float    @default(0)
  trialDays    Int      @default(14)
  features     String[] @default([])
  dependencies String[] @default([])
  isPublished  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyModules CompanyModule[]

  @@index([category, isActive])
  @@index([key])
}

/// Company-specific module entitlement (links Tenant/Company to Module with config).
model CompanyModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// ENABLED, DISABLED, TRIAL, EXPIRED
  status    String   @default("ENABLED")
  /// Module-specific configuration (JSON)
  config    Json?
  /// When the entitlement expires (for trials or time-limited modules)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, companyId, moduleId])
  @@index([tenantId, status])
  @@index([companyId, status])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── SUPPORT & TICKETING ──────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Support tickets raised by company administrators or platform users.
model SupportTicket {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// Subject/title of the ticket
  subject     String
  /// Detailed description
  description String
  /// Ticket category
  category    String   @default("GENERAL") // GENERAL, BILLING, TECHNICAL, FEATURE_REQUEST, COMPLIANCE, SECURITY
  /// Priority level
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT, CRITICAL
  /// Current status
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, WAITING_THIRD_PARTY, RESOLVED, CLOSED
  /// Who created the ticket
  createdById String
  createdBy   User     @relation("SupportTicketCreatedBy", fields: [createdById], references: [id])
  /// Assigned platform support agent
  assignedToId String?
  assignedTo   User?    @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id])
  /// SLA deadline
  slaDeadline DateTime?
  /// Resolution summary
  resolution  String?
  resolvedAt  DateTime?
  resolvedById String?
  resolvedBy   User?    @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    SupportTicketMessage[]

  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([assignedToId, status])
  @@index([priority, status])
  @@index([createdAt])
}

/// Messages/updates on a support ticket.
model SupportTicketMessage {
  id           String       @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  content      String
  /// INTERNAL (support team only) or PUBLIC (visible to customer)
  visibility   String       @default("PUBLIC")
  attachments  String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([ticketId, createdAt])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── PLATFORM USERS & ROLES ───────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Platform-level user accounts (Super Admin, Support, Operations).
/// Separate from tenant-scoped User model for platform operations.
model PlatformUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  /// SUPER_ADMIN, PLATFORM_SUPPORT, PLATFORM_OPS, PLATFORM_FINANCE
  role          String   @default("PLATFORM_SUPPORT")
  /// ACTIVE, SUSPENDED, INACTIVE
  status        String   @default("ACTIVE")
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdBy     PlatformUser? @relation("PlatformUserCreatedBy", fields: [createdById], references: [id])
  createdUsers  PlatformUser[] @relation("PlatformUserCreatedBy")

  // --- Super Admin Relations ---
  platformSettingsUpdated PlatformSetting[] @relation("PlatformSettingUpdatedBy")
  integrationsCreated     Integration[]   @relation("IntegrationCreatedBy")

  @@index([role, status])
  @@index([email])
}

/// Platform-wide settings and configuration.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String   @default("GENERAL") // GENERAL, BRANDING, SECURITY, NOTIFICATIONS, INTEGRATIONS, BILLING
  label       String
  description String?
  type        String   @default("STRING") // STRING, NUMBER, BOOLEAN, JSON, SELECT, SECRET
  value       String
  options     Json?    // For SELECT type: array of {label, value}
  isPublic    Boolean  @default(false) // Whether non-super-admin can read
  isEditable  Boolean  @default(true)  // Whether it can be changed via UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   PlatformUser? @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([category])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── INTEGRATIONS ──────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Platform and tenant-level integration configurations.
model Integration {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Integration type
  type        String   // EMAIL, SMS, ATTENDANCE_DEVICE, AI_SERVICE, PAYMENT_PROVIDER, CALENDAR, SSO
  /// Provider identifier (e.g., "sendgrid", "twilio", "stripe", "openai", "google", "microsoft")
  provider    String
  /// Configuration (encrypted for secrets)
  config      Json
  /// Whether this integration is enabled
  isEnabled   Boolean  @default(true)
  /// Whether this is a platform-level (global) or tenant-specific integration
  scope       String   @default("TENANT") // PLATFORM, TENANT
  name        String   // Human-readable name
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   PlatformUser? @relation("IntegrationCreatedBy", fields: [createdById], references: [id])

  // New Super Admin Relations
  healthChecks IntegrationHealth[]

  @@unique([tenantId, type, provider])
  @@index([tenantId, type])
  @@index([type, provider])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── SYSTEM HEALTH & MONITORING ───────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Background job execution tracking.
model BackgroundJob {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Job identifier (e.g., "payroll.run", "invoice.generate", "accrual.process")
  jobKey      String
  /// QUEUED, RUNNING, COMPLETED, FAILED, RETRYING, CANCELLED
  status      String   @default("QUEUED")
  /// Input parameters
  payload     Json?
  /// Result or error details
  result      Json?
  /// Error message if failed
  error       String?
  /// Number of retry attempts
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  /// Scheduled execution time
  scheduledAt DateTime?
  /// Actual start time
  startedAt   DateTime?
  /// Completion time
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, jobKey, status])
  @@index([status, scheduledAt])
  @@index([jobKey, status])
}

/// Integration health checks and status.
model IntegrationHealth {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// HEALTHY, DEGRADED, DOWN, UNKNOWN
  status        String   @default("UNKNOWN")
  /// Last check timestamp
  lastCheckAt   DateTime @default(now())
  /// Response time in milliseconds
  responseTimeMs Int?
  /// Error message if unhealthy
  error         String?
  /// Additional metrics
  metrics       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([integrationId])
  @@index([tenantId, status])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ─── TRAINING & CERTIFICATION ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

/// Training course catalog. Each tenant can define their own courses.
model TrainingCourse {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title           String
  code            String   // e.g., "HR-101", "SAFETY-001"
  description     String?
  category        String   // TECHNICAL, COMPLIANCE, SOFT_SKILLS, MANAGEMENT, ONBOARDING, SAFETY
  level           String   @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  durationHours   Float    @default(0)
  maxParticipants Int?
  /// DRAFT, PUBLISHED, ARCHIVED
  status          String   @default("DRAFT")
  /// Whether completion generates a certificate
  issuesCertificate Boolean  @default(true)
  /// Certificate template reference
  certificateTemplateId String?
  /// Prerequisite courses (self-referential)
  prerequisites   TrainingCourse[] @relation("CoursePrerequisites")
  /// Courses that require this as prerequisite
  requiredBy      TrainingCourse[] @relation("CoursePrerequisites")
  /// Tags for search/filtering
  tags            String[]
  /// External provider (if outsourced)
  provider        String?
  /// Cost per participant (for budget tracking)
  costPerParticipant Float? @default(0)
  currency        String   @default("AED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String
  createdBy       User     @relation("TrainingCourseCreatedBy", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?    @relation("TrainingCourseUpdatedBy", fields: [updatedById], references: [id])

  enrollments     TrainingEnrollment[]
  sessions        TrainingSession[]
  certificates    TrainingCertificate[]
  assessments     TrainingAssessment[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([companyId, status])
}

/// Training session/schedule for a course
model TrainingSession {
  id            String   @id @default(cuid())
  courseId      String
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title         String
  /// SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  status        String   @default("SCHEDULED")
  startDate     DateTime
  endDate       DateTime
  location      String?  // Physical or virtual (e.g., "Zoom", "Room 101", "Online")
  timezone      String   @default("Asia/Dubai")
  instructorId  String?
  instructor    User?    @relation("TrainingSessionInstructor", fields: [instructorId], references: [id])
  maxParticipants Int?
  /// Meeting link for virtual sessions
  meetingLink   String?
  /// Materials/attachments
  materials     String[] @default([])
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String
  createdBy     User     @relation("TrainingSessionCreatedBy", fields: [createdById], references: [id])

  enrollments   TrainingEnrollment[]
  attendances   TrainingAttendance[]

  @@index([courseId, status])
  @@index([tenantId, startDate])
  @@index([companyId, startDate])
  @@index([instructorId])
}

/// Employee enrollment in a training session
model TrainingEnrollment {
  id             String   @id @default(cuid())
  sessionId      String
  session        TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseId       String
  course         TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// REQUESTED, APPROVED, REJECTED, WAITLISTED, CANCELLED, COMPLETED
  status         String   @default("REQUESTED")
  /// APPROVED, REJECTED, PENDING
  approvalStatus String   @default("PENDING")
  approvedById   String?
  approvedBy     User?    @relation("TrainingEnrollmentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  /// Completion tracking
  completedAt    DateTime?
  score          Float?   // Assessment score if applicable
  /// PENDING, PASSED, FAILED
  assessmentStatus String  @default("PENDING")
  feedback       String?
  /// Certificate issued
  certificateId  String?
  certificate    TrainingCertificate?
  enrolledAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  enrolledById   String
  enrolledBy     User     @relation("TrainingEnrollmentEnrolledBy", fields: [enrolledById], references: [id])

  attendances    TrainingAttendance[]
  assessmentAttempts TrainingAssessmentAttempt[]
  employeeSkills EmployeeTrainingSkill[]

  @@unique([sessionId, employeeId])
  @@index([employeeId, status])
  @@index([courseId, status])
  @@index([tenantId, status])
  @@index([companyId, status])
  @@index([approvalStatus])
}

/// Attendance tracking for training sessions
model TrainingAttendance {
  id            String   @id @default(cuid())
  enrollmentId  String
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sessionId     String
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  /// PRESENT, ABSENT, LATE, EXCUSED
  status        String   @default("PRESENT")
  checkInAt     DateTime?
  checkOutAt    DateTime?
  durationMinutes Int    @default(0)
  notes         String?
  markedById    String
  markedBy      User     @relation("TrainingAttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([enrollmentId, date])
  @@index([sessionId, date])
  @@index([employeeId, date])
}

/// Training certificate issued upon completion
model TrainingCertificate {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentId    String   @unique
  enrollment      TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Certificate number (auto-generated: CERT-XXXXXX)
  certificateNumber String  @unique
  /// ISSUED, REVOKED, EXPIRED
  status          String   @default("ISSUED")
  /// Issue date
  issuedAt        DateTime @default(now())
  /// Expiry date (for certifications that expire)
  expiresAt       DateTime?
  /// Certificate title (e.g., "Certificate of Completion", "Certified Professional")
  title           String
  /// Grade/Score if applicable
  grade           String?
  score           Float?
  /// Verification code for public verification
  verificationCode String   @unique
  /// Digital signature hash
  signatureHash   String?
  /// Template used for generation
  templateId      String?
  /// Generated PDF/document URL
  documentUrl     String?
  pdfUrl          String?
  /// Employee photo at time of issuance (for certificate personalization)
  employeePhoto   String?
  /// Additional metadata (instructor, venue, etc.)
  metadata        Json?
  issuedById      String
  issuedBy        User     @relation("TrainingCertificateIssuedBy", fields: [issuedById], references: [id])
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       User?    @relation("TrainingCertificateRevokedBy", fields: [revokedById], references: [id])
  revocationReason String?
  employeeSkills  EmployeeTrainingSkill[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, status])
  @@index([courseId, issuedAt])
  @@index([verificationCode])
  @@index([certificateNumber])
}

/// Certificate template for generating certificates
model TrainingCertificateTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  /// DEFAULT, COURSE_COMPLETION, CERTIFICATION, ACCREDITATION
  type        String   @default("COURSE_COMPLETION")
  /// HTML/CSS template with placeholders
  htmlTemplate String
  /// CSS styles
  cssStyles   String?
  /// Placeholder fields available
  placeholders Json?  // e.g., ["employeeName", "courseTitle", "issueDate", "certificateNumber", "employeePhoto", "instructorName"]
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("TrainingCertificateTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, isDefault])
}

/// Training assessment/exam
model TrainingAssessment {
  id            String   @id @default(cuid())
  courseId      String
  course        TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  /// MCQ, ESSAY, PRACTICAL, PROJECT
  type          String   @default("MCQ")
  passingScore  Float    @default(70) // Percentage
  maxAttempts   Int      @default(3)
  timeLimitMinutes Int?   // null = no limit
  questions     Json     // Array of question objects
  /// DRAFT, PUBLISHED
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String
  createdBy     User     @relation("TrainingAssessmentCreatedBy", fields: [createdById], references: [id])

  attempts      TrainingAssessmentAttempt[]

  @@index([courseId, status])
  @@index([tenantId, status])
}

/// Employee assessment attempt
model TrainingAssessmentAttempt {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      TrainingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attemptNumber   Int      @default(1)
  /// IN_PROGRESS, SUBMITTED, GRADED, PASSED, FAILED
  status          String   @default("IN_PROGRESS")
  answers         Json?    // Employee's answers
  score           Float?
  maxScore        Float?
  /// Percentage score
  percentage      Float?
  startedAt       DateTime @default(now())
  submittedAt     DateTime?
  gradedAt        DateTime?
  gradedById      String?
  gradedBy        User?    @relation("TrainingAssessmentAttemptGradedBy", fields: [gradedById], references: [id])
  feedback        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([enrollmentId, attemptNumber])
  @@index([assessmentId, status])
  @@index([employeeId, status])
}

/// Training skill/competency tracking
model TrainingSkill {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  category      String   // TECHNICAL, SOFT_SKILLS, COMPLIANCE, MANAGEMENT, LANGUAGE
  description   String?
  /// Whether this skill can be certified
  isCertifiable Boolean  @default(false)
  /// Proficiency levels: BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  proficiencyLevels Json?  // [{"level": "BEGINNER", "description": "..."}, ...]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeeSkills EmployeeTrainingSkill[]

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@index([isActive])
}

/// Employee skill proficiency
model EmployeeTrainingSkill {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId       String
  skill         TrainingSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  level         String   @default("BEGINNER")
  /// Source of skill: TRAINING, EXPERIENCE, CERTIFICATION, SELF_ASSESSED, MANAGER_ASSESSED
  source        String   @default("SELF_ASSESSED")
  /// Related training enrollment if from training
  enrollmentId  String?
  enrollment    TrainingEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  /// Related certificate if from certification
  certificateId String?
  certificate   TrainingCertificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  assessedById  String?
  assessedBy    User?    @relation("EmployeeTrainingSkillAssessedBy", fields: [assessedById], references: [id])
  assessedAt    DateTime?
  expiresAt     DateTime? // For skills that need renewal
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, skillId])
  @@index([employeeId, level])
  @@index([tenantId, level])
  @@index([expiresAt])
}

/// Training category for organizing courses
model TrainingCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?  // Hex color for UI
  icon        String?  // Icon name
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

/// Application error tracking and monitoring.
model ApplicationError {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Error type/category
  type         String   // ERROR, WARNING, CRITICAL, PERFORMANCE
  /// Error message
  message      String
  /// Stack trace
  stackTrace   String?
  /// Request context (URL, method, user agent, etc.)
  context      Json?
  /// User who encountered the error
  userId       String?
  /// How many times this error occurred
  count        Int      @default(1)
  /// FIRST_SEEN, RECURRING, RESOLVED, IGNORED
  status       String   @default("FIRST_SEEN")
  /// Related job/ticket ID
  relatedId    String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([tenantId, type, status])
  @@index([status, lastSeenAt])
  @@index([type, status])
}

// ════════════════════════════════════════════════════════════════════════════════
// ─── AI SERVICES MARKETPLACE & USAGE GOVERNANCE ─────────────────────────────
// ════════════════════════════════════════════════════════════════════════════════

/// AI Modules published in the AI Marketplace (e.g. AI HR Assistant, AI CV Parser)
model AIModule {
  id          String   @id @default(cuid())
  key         String   @unique // ai_hr_assistant, ai_cv_parser, ai_doc_intel, ai_payroll, etc.
  name        String
  description String?
  category    String   @default("PRODUCTIVITY") // PRODUCTIVITY, RECRUITMENT, DOCUMENT, PAYROLL, ANALYTICS, VOICE
  provider    String   @default("OPENAI") // OPENAI, GOOGLE, ANTHROPIC
  defaultModel String  @default("gpt-4o")
  priceMonthly Float   @default(0)
  tokenAllowance Int   @default(500000) // Base tokens included per month
  isPublished Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usageLogs   AIUsageLog[]

  @@index([category, isActive])
  @@index([key])
}

/// AI Usage tracking per tenant, company, and user
model AIUsageLog {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?
  userId      String?
  user        User?     @relation("AIUsageLogUser", fields: [userId], references: [id], onDelete: SetNull)
  aiModuleKey String
  aiModule    AIModule? @relation(fields: [aiModuleKey], references: [key], onDelete: SetNull)
  provider    String
  model       String
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  estimatedCostAed Float @default(0)
  actionName       String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([aiModuleKey, createdAt])
}

/// Tenant-level AI monthly budget limits & safety controls
model AICompanyBudget {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monthlyBudgetAed Float @default(500)
  currentSpendAed  Float @default(0)
  hardStopEnabled Boolean @default(true)
  warningThresholdPercent Int @default(80)
  updatedAt     DateTime @updatedAt
}

/// Employee Promotion record
model EmployeePromotion {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromTitle       String
  toTitle         String
  fromGrade       String?
  toGrade         String?
  fromSalary      Float?
  toSalary        Float?
  proposedBasicSalary Float?
  proposedHousing     Float?
  proposedTransport   Float?
  proposedOther       Float?
  proposedDesignation String?
  previousBasicSalary Float?
  previousHousing     Float?
  previousTransport   Float?
  previousOther       Float?
  previousDesignation String?
  effectiveDate   DateTime
  reason          String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?
  approvedBy      User?    @relation("EmployeePromotionApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  pdfUrl          String?
  createdById     String?
  createdBy       User?    @relation("EmployeePromotionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId, effectiveDate])
  @@index([tenantId, status])
}


// ─── FINANCE, BUDGET, PETTY CASH, PROCUREMENT & INVENTORY MODULE ──────────

/// Cost Centre for multi-dimensional budgeting and expenditure allocation
model CostCentre {
  id          String   @id @default(cuid())
  tenantId    String?
  companyId   String?
  code        String
  name        String
  description String?
  departmentId String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgets      Budget[]
  transactions PettyCashTransaction[]

  @@unique([companyId, code])
  @@index([tenantId])
  @@index([companyId])
}

/// Annual and monthly budget allocation
model Budget {
  id              String   @id @default(cuid())
  tenantId        String?
  companyId       String?
  departmentId    String?
  costCentreId    String?
  costCentre      CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  name            String
  fiscalYear      Int
  totalAmount     Decimal  @default(0)
  allocatedAmount Decimal  @default(0)
  committedAmount Decimal  @default(0)
  actualSpent     Decimal  @default(0)
  status          String   @default("DRAFT") // DRAFT, APPROVED, ACTIVE, CLOSED
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revisions       BudgetRevision[]
  alerts          BudgetAlert[]
  purchaseReqs    PurchaseRequisition[]

  @@index([tenantId, fiscalYear])
  @@index([companyId, fiscalYear])
}

model BudgetRevision {
  id             String   @id @default(cuid())
  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  previousAmount Decimal
  newAmount      Decimal
  reason         String
  requestedBy    String
  approvedBy     String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())

  @@index([budgetId])
}

model BudgetAlert {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  alertType String   // THRESHOLD_80, THRESHOLD_90, THRESHOLD_100, OVERRUN
  threshold Int      @default(80)
  isActive  Boolean  @default(true)
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([budgetId])
}

/// Petty Cash Management
model PettyCashFund {
  id             String   @id @default(cuid())
  tenantId       String?
  companyId      String?
  name           String
  custodianId    String?
  openingBalance Decimal  @default(0)
  currentBalance Decimal  @default(0)
  currency       String   @default("AED")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   PettyCashTransaction[]
  replenishments PettyCashReplenishment[]

  @@index([tenantId])
  @@index([companyId])
}

model PettyCashTransaction {
  id              String   @id @default(cuid())
  fundId          String
  fund            PettyCashFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  employeeId      String?
  description     String
  category        String   // Office Supplies, Travel, Meals, Fuel, Misc
  amount          Decimal
  transactionType String   @default("PAYMENT") // PAYMENT, RECEIPT
  receiptUrl      String?
  supplierId      String?
  costCentreId    String?
  costCentre      CostCentre? @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, POSTED
  approvedBy      String?
  approvedAt      DateTime?
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fundId, status])
}

model PettyCashReplenishment {
  id              String   @id @default(cuid())
  fundId          String
  fund            PettyCashFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  requestedAmount Decimal
  approvedAmount  Decimal?
  requestedBy     String
  approvedBy      String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fundId])
}

/// Supplier Master & Procurement Management
model Supplier {
  id              String   @id @default(cuid())
  tenantId        String?
  companyId       String?
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  taxRegistration String?  // TRN (Tax Registration Number)
  bankName        String?
  bankAccount     String?
  iban            String?
  currency        String   @default("AED")
  paymentTerms    String?  // NET_30, NET_60, IMMEDIATE, etc.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  invoices        SupplierInvoice[]
  inventoryItems  InventoryItem[]

  @@index([tenantId])
  @@index([companyId])
}

model PurchaseRequisition {
  id              String   @id @default(cuid())
  tenantId        String?
  companyId       String?
  departmentId    String?
  requestedBy     String   // employeeId
  title           String
  description     String?
  estimatedAmount Decimal  @default(0)
  budgetId        String?
  budget          Budget?  @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, ORDERED, CANCELLED
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseRequisitionItem[]
  purchaseOrders  PurchaseOrder[]

  @@index([tenantId, status])
  @@index([companyId, status])
}

model PurchaseRequisitionItem {
  id               String   @id @default(cuid())
  requisitionId    String
  requisition      PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  description      String
  quantity         Int      @default(1)
  unit             String   @default("PCS")
  estimatedUnitCost Decimal @default(0)
  totalCost        Decimal  @default(0)
  category         String   @default("GENERAL")
  notes            String?

  @@index([requisitionId])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  tenantId        String?
  companyId       String?
  requisitionId   String?
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  orderNumber     String   @unique
  title           String
  status          String   @default("DRAFT") // DRAFT, SENT, CONFIRMED, PARTIAL_RECEIVED, RECEIVED, CANCELLED
  totalAmount     Decimal  @default(0)
  currency        String   @default("AED")
  orderDate       DateTime @default(now())
  expectedDelivery DateTime?
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  invoices        SupplierInvoice[]

  @@index([tenantId, status])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int      @default(1)
  unit            String   @default("PCS")
  unitCost        Decimal  @default(0)
  totalCost       Decimal  @default(0)
  receivedQty     Int      @default(0)

  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy      String   // employeeId
  receivedDate    DateTime @default(now())
  notes           String?
  status          String   @default("COMPLETE") // PENDING, PARTIAL, COMPLETE
  createdAt       DateTime @default(now())

  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  receivedQty         Int      @default(1)
  condition           String   @default("GOOD") // GOOD, DAMAGED, REJECTED
  notes               String?

  @@index([goodsReceiptId])
}

model SupplierInvoice {
  id              String   @id @default(cuid())
  tenantId        String?
  companyId       String?
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime
  amount          Decimal  @default(0)
  vatAmount       Decimal  @default(0)
  totalAmount     Decimal  @default(0)
  currency        String   @default("AED")
  status          String   @default("RECEIVED") // RECEIVED, VERIFIED, APPROVED, PAID, DISPUTED
  paidAmount      Decimal  @default(0)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([supplierId, status])
}

/// Office Supplies & Consumable Inventory
model InventoryItem {
  id             String   @id @default(cuid())
  tenantId       String?
  companyId      String?
  sku            String
  name           String
  description    String?
  category       String   // Stationery, Pantry, Cleaning, IT Accessories
  unitOfMeasure  String   @default("PCS")
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  unitCost       Decimal  @default(0)
  currentStock   Int      @default(0)
  minimumStock   Int      @default(5)
  reorderPoint   Int      @default(10)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockMovements StockMovement[]
  supplyItems    DepartmentSupplyRequestItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([companyId])
}

model StockMovement {
  id              String   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  movementType    String   // RECEIPT, ISSUE, RETURN, ADJUSTMENT
  quantity        Int
  unitCost        Decimal?
  referenceType   String?  // PO, SUPPLY_REQUEST, MANUAL_ADJUSTMENT
  referenceId     String?
  departmentId    String?
  employeeId      String?
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([inventoryItemId])
}

model DepartmentSupplyRequest {
  id           String   @id @default(cuid())
  tenantId     String?
  companyId    String?
  departmentId String?
  requestedBy  String   // employeeId
  status       String   @default("PENDING") // PENDING, APPROVED, ISSUED, REJECTED
  notes        String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        DepartmentSupplyRequestItem[]

  @@index([tenantId, status])
  @@index([departmentId, status])
}

model DepartmentSupplyRequestItem {
  id             String   @id @default(cuid())
  requestId      String
  request        DepartmentSupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  requestedQty   Int      @default(1)
  issuedQty      Int      @default(0)
  notes          String?

  @@index([requestId])
}

